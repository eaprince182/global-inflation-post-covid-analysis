import pandas as pd

df = pd.read_csv("../data/raw/global_inflation_post_covid.csv")

df.columns = (
    df.columns
    .str.lower()
    .str.strip()
    .str.replace(" ", "_")
)

df["date"] = pd.to_datetime(df["date"])

df = df.drop_duplicates()

df.to_csv("../data/processed/cleaned_global_inflation.csv", index=False)
